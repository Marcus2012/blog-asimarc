{{!< default}}

{{#post}}
<main class="main-container">
    <article class="single-article">
        <header class="article-header">
            {{#if primary_tag}}
                <a href="{{primary_tag.url}}" class="post-tag">{{primary_tag.name}}</a>
            {{/if}}
            <h1 class="article-title">{{title}}</h1>
            <div class="post-card-footer" style="justify-content: center; margin-top: 1rem;">
                {{#if primary_author.profile_image}}
                    <img class="author-avatar" src="{{primary_author.profile_image}}" alt="{{primary_author.name}}">
                {{/if}}
                <span>Por <strong>{{primary_author.name}}</strong></span> &bull;
                <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD [de] MMMM, YYYY"}}</time> &bull;
                <span>{{reading_time minute="1 min de lectura" minutes="% min de lectura"}}</span>
            </div>
        </header>

        {{#if feature_image}}
            <img class="article-feature-image" src="{{img_url feature_image size="xl"}}" alt="{{title}}">
        {{/if}}

        <div class="article-content">
            {{content}}
        </div>
    </article>
</main>
{{/post}}
