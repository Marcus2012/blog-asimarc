{{!< default}}

<section class="hero-section">
    <div class="hero-content">
        <div class="hero-breadcrumb">
            <a href="{{@site.url}}">🏠 Inicio</a>
            <span>&rsaquo;</span>
            <span>Noticias & Conciliación</span>
        </div>
        <h1 class="hero-title">{{#if @site.title}}{{@site.title}}{{else}}Blog & Portal de Conciliación{{/if}}</h1>
        <p class="hero-subtitle">
            {{#if @site.description}}
                {{@site.description}}
            {{else}}
                Un espacio académico e informativo donde encontrarás artículos de opinión, análisis normativos, guías y novedades sobre la conciliación y los mecanismos alternativos de resolución de conflictos.
            {{/if}}
        </p>
    </div>
</section>

<!-- Caja de Búsqueda y Filtros Flotante inspirada en Ventana Jurídica PUCP -->
<div class="filter-box-container">
    <div class="filter-box">
        <form data-ghost-search class="search-row">
            <div class="search-input-wrapper">
                <span class="search-icon">🔍</span>
                <input type="text" class="search-input" placeholder="Ingresa tus términos de búsqueda..." />
            </div>
            <button type="submit" class="btn-search-submit">Buscar</button>
        </form>
        
        <div class="filter-row">
            <div class="filter-group">
                <label for="cat-select">Categoría:</label>
                <select id="cat-select" class="filter-select">
                    <option value="">Todas</option>
                    <option value="noticias">Noticias & Actualidad</option>
                    <option value="normativa">Normativa & Decretos</option>
                    <option value="jurisprudencia">Casos & Jurisprudencia</option>
                    <option value="guias">Guías & Formatos</option>
                </select>
            </div>

            <div class="filter-group">
                <label for="date-from">Desde:</label>
                <input type="date" id="date-from" class="filter-date" value="2020-01-01" />
            </div>

            <div class="filter-group">
                <label for="date-to">Hasta:</label>
                <input type="date" id="date-to" class="filter-date" value="2026-12-31" />
            </div>
        </div>
    </div>
</div>

<main class="main-container">
    <div class="posts-grid">
        {{#foreach posts}}
            <article class="post-card">
                {{#if feature_image}}
                    <a href="{{url}}">
                        <img class="post-card-image" src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy">
                    </a>
                {{/if}}
                
                <div class="post-card-body">
                    {{#if primary_tag}}
                        <a href="{{primary_tag.url}}" class="post-tag">{{primary_tag.name}}</a>
                    {{else}}
                        <span class="post-tag">CONCILIACIÓN</span>
                    {{/if}}

                    <h3 class="post-card-title">
                        <a href="{{url}}">{{title}}</a>
                    </h3>

                    <p class="post-card-excerpt">{{excerpt words="25"}}...</p>

                    <div class="post-card-footer">
                        <span>✍️ {{primary_author.name}}</span> &bull; 
                        <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time>
                    </div>
                </div>
            </article>
        {{/foreach}}
    </div>

    {{pagination}}
</main>
