{{!< default}}

<section class="hero-section">
    <div class="hero-content">
        <h1 class="hero-title">{{#if @site.title}}{{@site.title}}{{else}}Noticias de Conciliación & Arbitraje{{/if}}</h1>
        <p class="hero-subtitle">{{#if @site.description}}{{@site.description}}{{else}}El portal especializado en actualización jurídica, mecanismos alternativos de resolución de conflictos y normativa.{{/if}}</p>
    </div>
</section>

<main class="main-container">
    <div class="section-header">
        <h2 class="section-title">Últimas Noticias & Publicaciones</h2>
    </div>

    <div class="posts-grid">
        {{#foreach posts}}
            <article class="post-card">
                {{#if feature_image}}
                    <a href="{{url}}">
                        <img class="post-card-image" src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy">
                    </a>
                {{/if}}
                
                <div class="post-card-body">
                    {{#if primary_tag}}
                        <a href="{{primary_tag.url}}" class="post-tag">{{primary_tag.name}}</a>
                    {{/if}}

                    <h3 class="post-card-title">
                        <a href="{{url}}">{{title}}</a>
                    </h3>

                    <p class="post-card-excerpt">{{excerpt words="25"}}...</p>

                    <div class="post-card-footer">
                        {{#if primary_author.profile_image}}
                            <img class="author-avatar" src="{{primary_author.profile_image}}" alt="{{primary_author.name}}">
                        {{/if}}
                        <span>{{primary_author.name}}</span> &bull; 
                        <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time>
                    </div>
                </div>
            </article>
        {{/foreach}}
    </div>

    {{pagination}}
</main>
