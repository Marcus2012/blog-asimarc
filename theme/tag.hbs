{{!< default}}

{{#tag}}
<section class="hero-section">
    <div class="hero-content">
        <span class="post-tag" style="background: rgba(255,255,255,0.2); color: white;">Categoría</span>
        <h1 class="hero-title">{{name}}</h1>
        {{#if description}}
            <p class="hero-subtitle">{{description}}</p>
        {{/if}}
    </div>
</section>
{{/tag}}

<main class="main-container">
    <div class="posts-grid">
        {{#foreach posts}}
            <article class="post-card">
                {{#if feature_image}}
                    <a href="{{url}}">
                        <img class="post-card-image" src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy">
                    </a>
                {{/if}}
                
                <div class="post-card-body">
                    <h3 class="post-card-title">
                        <a href="{{url}}">{{title}}</a>
                    </h3>

                    <p class="post-card-excerpt">{{excerpt words="25"}}...</p>

                    <div class="post-card-footer">
                        <span><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time></span>
                    </div>
                </div>
            </article>
        {{/foreach}}
    </div>

    {{pagination}}
</main>
