{{!< default}}

{{#tag}}
<header class="tag-header-section">
    <div class="tag-header-container">
        <div class="hero-breadcrumbs">
            <a href="{{@site.url}}">🏠 Inicio</a>
            <span>&rsaquo;</span>
            <span>Etiqueta</span>
        </div>
        
        <h1 class="tag-title">
            <span class="tag-icon">🏷️</span> {{name}}
        </h1>
        
        {{#if description}}
            <p class="tag-description">{{description}}</p>
        {{else}}
            <p class="tag-description">
                Artículos, análisis y publicaciones clasificadas bajo la categoría de <strong>{{name}}</strong> en el portal de ASIMARC.
            </p>
        {{/if}}
        
        <div class="tag-count">
            {{plural ../pagination.total empty='Sin publicaciones' singular='% artículo encontrado' plural='% artículos encontrados'}}
        </div>
    </div>
</header>
{{/tag}}

<div class="content-container">
    <section class="posts-section">
        {{#if posts}}
            <div class="posts-grid">
                {{#foreach posts}}
                    {{> "post-card"}}
                {{/foreach}}
            </div>
            {{pagination}}
        {{else}}
            <div class="empty-category-card">
                <span class="empty-icon">📁</span>
                <h3 class="empty-title">Próximamente artículos en {{#tag}}{{name}}{{/tag}}</h3>
                <p class="empty-desc">
                    Aún no se han publicado artículos en esta sección. Muy pronto nuestro equipo publicará novedades, doctrina y análisis especializados.
                </p>
                <a href="{{@site.url}}" class="btn-empty-home">&larr; Volver a la portada</a>
            </div>
        {{/if}}
    </section>
</div>
