<article class="post-card {{#if featured}}featured-card{{/if}} {{post_class}}">
    {{#if feature_image}}
        <a href="{{url}}" class="post-card-media">
            <img class="post-card-image"
                 srcset="{{img_url feature_image size="s"}} 300w,
                         {{img_url feature_image size="m"}} 600w,
                         {{img_url feature_image size="l"}} 1000w"
                 sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
                 src="{{img_url feature_image size="m"}}"
                 alt="{{title}}"
                 loading="lazy" />
            <div class="media-overlay"></div>
        </a>
    {{/if}}

    <div class="post-card-content">
        <div class="post-card-header">
            {{#if primary_tag}}
                <a href="{{primary_tag.url}}" class="post-badge badge-{{primary_tag.slug}}">
                    {{primary_tag.name}}
                </a>
            {{else}}
                <span class="post-badge badge-general">CONCILIACIÓN</span>
            {{/if}}

            <span class="reading-time">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                {{reading_time minute="1 min" minutes="% min"}}
            </span>
        </div>

        <h3 class="post-card-title">
            <a href="{{url}}">{{title}}</a>
        </h3>

        <p class="post-card-excerpt">
            {{excerpt words="24"}}...
        </p>

        <div class="post-card-footer">
            <div class="author-meta">
                {{#if primary_author.profile_image}}
                    <img class="author-avatar" src="{{primary_author.profile_image}}" alt="{{primary_author.name}}" />
                {{else}}
                    <div class="author-avatar-fallback">✍️</div>
                {{/if}}
                <span class="author-name">{{primary_author.name}}</span>
            </div>

            <time class="post-date" datetime="{{date format="YYYY-MM-DD"}}">
                {{date format="DD MMM, YYYY"}}
            </time>
        </div>
    </div>
</article>
